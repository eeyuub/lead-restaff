# ============ DATABASE ============
DATABASE_URL=postgresql://restaff:restaff@localhost:5432/restaff_leads

# ============ APP ============
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000  # public URL of backend (for Apify webhooks). Must be HTTPS in prod.

# Simple API key gate (sent as x-api-key header by frontend). Generate with: openssl rand -hex 32
INTERNAL_API_KEY=change_me_to_a_long_random_string

# ============ APIFY ============
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxx
APIFY_ACTOR_ID=lukaskrivka~google-maps-with-contact-details
# Apify will call PUBLIC_URL/apify/webhook?secret=APIFY_WEBHOOK_SECRET. Generate fresh.
APIFY_WEBHOOK_SECRET=change_me_to_a_long_random_string

# ============ WIISENDER (WhatsApp via @wiicode/wiisender) ============
WIISENDER_SERVER_URL=https://wiisender.wiicode.com
WIISENDER_API_KEY=wsk_your_api_key_here

# ============ OPENAI ============
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
# Optional — for OpenAI-compatible gateways (Azure, OpenRouter, local). Leave blank for default.
OPENAI_BASE_URL=

# ============ FRONTEND (Vite) ============
VITE_API_URL=http://localhost:3000
VITE_INTERNAL_API_KEY=same_as_INTERNAL_API_KEY_above
